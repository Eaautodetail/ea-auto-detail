# Kopiera till .env.local (lokalt) eller lägg in hos värden (t.ex. Vercel → Settings → Environment Variables).
# Lägg ALDRIG in riktiga nycklar i koden eller i git.

# Sajtens riktiga adress, utan avslutande snedstreck. Används för sitemap, delningsbilder och sökmotorer.
NEXT_PUBLIC_SITE_URL=https://www.example.se

# Sätt till true först när sajten är klar att visas i Google. Annars blockeras indexering i robots.txt.
NEXT_PUBLIC_ALLOW_INDEXING=false

# --- Bokningsförfrågningar: välj minst ett av alternativen nedan -------------

# Alternativ A: E-post via Resend (https://resend.com, gratisnivå räcker).
# BOOKING_EMAIL_FROM måste vara en avsändare på en domän ni har verifierat i Resend.
RESEND_API_KEY=
BOOKING_EMAIL_TO=
BOOKING_EMAIL_FROM=

# Alternativ B: Webhook (Make, Zapier, n8n, Google Apps Script → Google Sheets m.m.).
# Tar emot JSON med förfrågan, se README.
BOOKING_WEBHOOK_URL=
# Valfritt: skickas i headern X-Webhook-Secret så att mottagaren kan verifiera avsändaren.
BOOKING_WEBHOOK_SECRET=
