# Kopiera till .env.local (lokalt) eller lägg in hos värden (t.ex. Vercel → Settings → Environment Variables).
# Lägg ALDRIG in riktiga nycklar eller lösenord i koden eller i git.

# Sajtens riktiga adress, utan avslutande snedstreck. Används för sitemap, delningsbilder och länkar i mejl.
NEXT_PUBLIC_SITE_URL=https://www.example.se

# Sätt till true först när sajten är klar att visas i Google. Annars blockeras indexering i robots.txt.
NEXT_PUBLIC_ALLOW_INDEXING=false

# =============================================================================
# E-POST – bokningsförfrågningar, kvitton och bekräftelser
# =============================================================================
# Hemsidan skickar tre sorters mejl:
#   1. Till er: varje ny bokningsförfrågan (med bilder och en länk för att bekräfta tiden).
#   2. Till kunden: ett automatiskt KVITTO – "vi har tagit emot din förfrågan". Det står
#      tydligt att tiden INTE är bekräftad än.
#   3. Till kunden: en BEKRÄFTELSE när ni har godkänt en tid (skickas från sidan /hantera).
#
# Mejl 2 och 3 kräver alternativ A (Gmail med applösenord) ELLER Resend med en egen,
# verifierad domän. Med Resends testavsändare (onboarding@resend.dev) fungerar bara mejl 1.
# Är ingenting konfigurerat säger formuläret ärligt att förfrågan inte kunde skickas.

# --- Alternativ A (rekommenderas): Gmail via SMTP med applösenord -------------
# 1. Slå på tvåstegsverifiering på Google-kontot (myaccount.google.com/security).
#    Utan tvåstegsverifiering går det inte att skapa applösenord.
# 2. Skapa ett applösenord på myaccount.google.com/apppasswords (namn t.ex. "Hemsida").
# 3. Klistra in lösenordet (16 tecken) i SMTP_PASS. Mellanslagen spelar ingen roll.
# Använd ALDRIG kontots vanliga lösenord här. Applösenordet kan tas bort när som helst
# på samma sida – då slutar hemsidan skicka mejl tills ett nytt läggs in.
SMTP_USER=eaautodetail2026@gmail.com
SMTP_PASS=
# Alternativ: GMAIL_APP_PASSWORD fungerar också (då används eaautodetail2026@gmail.com som avsändare om SMTP_USER/GMAIL_USER saknas).
# Valfritt – standard är Gmail: smtp.gmail.com, port 465 med TLS. Ändra bara om ni byter e-posttjänst.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_SECURE=true

# --- Alternativ B: Resend (https://resend.com) ---------------------------------
# Används bara om SMTP_USER och SMTP_PASS inte båda är ifyllda.
# Testavsändaren onboarding@resend.dev (kontot skapat med eaautodetail2026@gmail.com) kan bara
# skicka till kontots egen adress: ni får förfrågningarna, men kunder får INGET kvitto och
# ingen bekräftelse. Med egen domän: verifiera domänen i Resend och använd t.ex.
# "EA Auto Detail <bokning@er-doman.se>" som avsändare – då fungerar mejl till kunder också.
RESEND_API_KEY=
BOOKING_EMAIL_FROM="EA Auto Detail <onboarding@resend.dev>"

# Vem som får mejlen om nya förfrågningar (flera adresser separeras med komma).
# Krävs för Resend. Med Gmail/SMTP kan ni lämna den tom – då används SMTP_USER.
BOOKING_EMAIL_TO=eaautodetail2026@gmail.com

# --- Nyckel för bekräftelselänkarna (valfritt men rekommenderat) -------------
# Länken "Bekräfta tid och skicka bekräftelse" i mejlet till er innehåller förfrågans uppgifter,
# krypterade med den här nyckeln. Är den tom används SMTP_PASS eller RESEND_API_KEY i stället –
# då slutar gamla länkar fungera om ni byter applösenordet eller nyckeln.
# Skapa en lång slumpmässig sträng (minst 32 tecken), t.ex. med: openssl rand -base64 32
# Byter ni BOOKING_SECRET slutar länkar som skapats med den gamla att fungera.
BOOKING_SECRET=

# =============================================================================
# Webhook (valfritt) – Make, Zapier, n8n, Google Apps Script → Google Sheets m.m.
# =============================================================================
# Tar emot JSON med varje förfrågan, se README. Kan användas i stället för eller tillsammans med e-post.
BOOKING_WEBHOOK_URL=
# Valfritt: skickas i headern X-Webhook-Secret så att mottagaren kan verifiera avsändaren.
BOOKING_WEBHOOK_SECRET=
